47ff-4025-9699-c5f9caa98b43","nome_completo":"Joao Invalido","cpf":"52998224725","data_nascimento":"1991-01-15T03:00:00.000Z","email":"joao.valido@email.com","ativo":false,"criado_em":"2026-09-25T00:48:57.989Z","perfil":"leitor"}],"obras":[{"id":"6cbecaac-a955-4698-ae52-23f4b7420080","titulo":"Rascunho para descarte","autor":"Teste","categoria":"Outros","quantidade":1,"situacao":"descartada","criado_em":"2026-09-25T01:08:39.725Z","capa":null,"pdf":null,"descricao":null},{"id":"209990d0-42a0-4c3a-8c8a-72db8bd889e9","titulo":"Dom Casmurro","autor":"Machado de Assis","categoria":"Literatura Brasileira","quantidade":3,"situacao":"descartada","criado_em":"2026-09-25T01:08:04.873Z","capa":null,"pdf":null,"descricao":null},{"id":"8023e036-54af-41d7-9629-a58e24da095f","titulo":"O Pequeno Príncipe","autor":"Antoine de Saint-Exupéry","categoria":"infantil","quantidade":30,"situacao":"descartada","criado_em":"2026-09-25T02:12:18.497Z","capa":null,"pdf":null,"descricao":null},{"id":"ca7c1e2e-e146-4734-b27e-59362ee35018","titulo":"teste","autor":"teste","categoria":"teste","quantidade":6,"situacao":"descartada","criado_em":"2026-09-25T01:10:53.324Z","capa":null,"pdf":null,"descricao":null},{"id":"bcb463b0-0d13-4c4f-9012-8ba44424e73c","titulo":"teste 1","autor":"teste 2","categoria":"teste 3","quantidade":1,"situacao":"descartada","criado_em":"2026-09-25T13:15:06.949Z","capa":null,"pdf":null,"descricao":null},{"id":"7d47b797-c4af-448a-840b-4d5ceb7afe4d","titulo":"Capa de exemplo","autor":"Machado de Assis","categoria":"Literatura Brasileira","quantidade":1,"situacao":"descartada","criado_em":"2026-09-25T13:32:41.000Z","capa":"/capas/fece6aa9-6e7d-45d8-af3e-be1db8ab670a.png","pdf":null,"descricao":null},{"id":"46c46f4e-1502-49ad-aad5-3024d7a899e2","titulo":"História do Brasil","autor":"Boris Fausto","categoria":"Ciências Humanas e Sociais / História do Brasil / Didático e Acadêmico","quantidade":1,"situacao":"ativa","criado_em":"2026-09-25T14:23:28.852Z","capa":"/capas/6b8d0176-4fe4-4bc6-81dc-2ddce1fea17d.jpg","pdf":"/pdfs/a9bb7af6-d9bd-4f23-b6dc-00db5fc889b1.pdf","descricao":"Este livro apresenta a história do Brasil, desde a chegada dos portugueses em 1500 até os dias atuais. Aborda os principais acontecimentos que marcaram a formação do país, incluindo o período colonial, a independência, o Império, a Proclamação da República e as transformações políticas, sociais e econômicas ao longo dos anos.\n\nUma leitura importante para compreender a origem do Brasil, sua cultura, seus desafios e as mudanças que contribuíram para a construção da sociedade brasileira."},{"id":"63e8d580-4202-462a-9a28-69165d065f07","titulo":"O Pequeno Príncipe","autor":"Antoine de Saint-Exupéry","categoria":"Infantil","quantidade":1,"situacao":"ativa","criado_em":"2026-09-25T13:38:29.571Z","capa":"/capas/69b1ce58-6b2b-4ebd-8eff-8e2012c2fa2c.webp","pdf":"/pdfs/73edba73-9322-4147-8cd6-0e62a5138f83.pdf","descricao":"O Pequeno Príncipe é uma obra que conta a história de um pequeno príncipe que vive em um pequeno asteroide e viaja por diferentes planetas, conhecendo personagens que o ajudam a compreender a vida, a amizade e os sentimentos humanos.\n\nAo chegar à Terra, ele encontra um aviador e compartilha suas experiências e aprendizados. Com uma narrativa encantadora e cheia de reflexões, o livro aborda temas como amor, amizade, responsabilidade e a importância de enxergar além das aparências. É uma leitura que transmite lições valiosas para pessoas de todas as idades."},{"id":"45caf15a-3089-49b7-aaa8-9310ab58760c","titulo":"Presença indígena no Brasil","autor":"Mércio Pereira Gomes","categoria":"História, Ciências Sociais","quantidade":1,"situacao":"ativa","criado_em":"2026-09-25T14:51:59.726Z","capa":"/capas/d9f2c9cb-fe89-4a3a-baba-b5181af4988a.jpg","pdf":"/pdfs/80c3856d-91aa-4ded-8881-fa06c01e49d4.pdf","descricao":"Este livro aborda a história, a cultura e a importância dos povos indígenas na formação do Brasil. Apresenta suas tradições, costumes, línguas, formas de organização social e a relação com a natureza, além dos desafios enfrentados ao longo da história, como a colonização, a perda de territórios e a luta pelos direitos indígenas.\n\nUma leitura que contribui para o conhecimento e a valorização da diversidade cultural dos povos originários, destacando sua presença e importância na sociedade brasileira até os dias atuais."},{"id":"3b8ecb46-e468-40ad-8362-cda9dbf3c84e","titulo":"Harry Potter e o Enigma do Príncipe","autor":"J.K Rowling","categoria":"Fantasia, Aventura e Ficção Juvenil","quantidade":1,"situacao":"ativa","criado_em":"2026-09-25T19:30:40.814Z","capa":"/capas/5eacc989-e11e-4ee8-9715-c121dacbca31.jpg","pdf":"/pdfs/5d6248b4-a713-4e0c-ba71-c56bfff7ea56.pdf","descricao":"Em Harry Potter e o Enigma do Príncipe, Harry retorna para seu sexto ano em Hogwarts e descobre mais sobre o passado de Lord Voldemort. Com a ajuda do professor Dumbledore, ele investiga os segredos que envolvem o maior inimigo do mundo bruxo e busca entender como derrotá-lo. Durante sua jornada, Harry encontra um misterioso livro de poções que pertenceu ao enigmático Príncipe Mestiço, capaz de transformar suas habilidades e revelar segredos inesperados. Entre descobertas, amizades e desafios, Harry se aproxima cada vez mais da batalha decisiva contra as forças das trevas."}],"sugestoes":[{"id":"6369d0d3-f6f5-4f88-b8bd-ec8b7e7e28e4","titulo_livro":"teste","autor":"teste","categoria":"teste","justificativa":"teste","usuario_id":"f646b6d4-1b27-4094-94fb-fb038f17d7e3","status":"rejeitada","resposta_admin":null,"criado_em":"2026-09-25T13:00:48.160Z","atualizado_em":"2026-09-25T13:14:40.763Z"},{"id":"22cb689a-e92f-405d-aebd-1de93bc57d10","titulo_livro":"Harry Potter e a Ordem da Fênix","autor":"J. K. Rowling","categoria":"fantasia, ficção e literatura infanto-juvenil (ou jovem adulto).","justificativa":"-x-","usuario_id":"2b3ea58a-c23a-4dfd-9a30-d04252f8fdb9","status":"aprovada","resposta_admin":null,"criado_em":"2026-09-25T14:09:40.497Z","atualizado_em":"2026-09-25T14:10:06.795Z"},{"id":"13949500-909a-4575-879c-fa91a2212c3e","titulo_livro":"Presença indígena no Brasil","autor":"Mércio Pereira Gomes","categoria":"História, Ciências Sociais","justificativa":"-x-","usuario_id":"2b3ea58a-c23a-4dfd-9a30-d04252f8fdb9","status":"aprovada","resposta_admin":null,"criado_em":"2026-09-25T14:50:19.673Z","atualizado_em":"2026-09-25T14:50:37.545Z"},{"id":"2b6d8793-5857-4646-89fe-5e420dc43fa6","titulo_livro":"Teste","autor":null,"categoria":null,"justificativa":null,"usuario_id":"f646b6d4-1b27-4094-94fb-fb038f17d7e3","status":"rejeitada","resposta_admin":null,"criado_em":"2026-09-25T16:20:09.786Z","atualizado_em":"2026-09-25T16:37:18.629Z"},{"id":"d0941aa2-2928-4970-b4bb-140b7ff95d81","titulo_livro":"teste","autor":"teste","categoria":"teste","justificativa":"teste","usuario_id":"2b3ea58a-c23a-4dfd-9a30-d04252f8fdb9","status":"rejeitada","resposta_admin":"Não gostei","criado_em":"2026-09-27T18:02:33.098Z","atualizado_em":"2026-09-27T18:03:32.531Z"}]}